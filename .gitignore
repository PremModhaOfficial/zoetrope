/target
# The browser frontend resolves as its own workspace (it is wasm32-only, so it
# cannot be a member of this one — see the [workspace] comment in Cargo.toml),
# which means it gets its own target dir rather than sharing /target.
/web/wasm/target
/dist
/.playwright-mcp
.DS_Store

